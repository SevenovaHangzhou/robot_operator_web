# ~/.config/robot-operator-web/env — one file per host. Fill every value; nothing has a default.
# DDS settings must match the running stack (see integ_operator_web/README.md, “启动”).
ROBOT_DRIVER_SETUP=/path/to/robot_driver/install/setup.bash
OPERATOR_WEB_INSTALL=/home/USER/.local/share/robot-operator-web/current/install
OPERATOR_WEB_BIND_HOST=192.168.0.10
OPERATOR_WEB_PORT=18110
OPERATOR_WEB_CPUS=0,2,4
# Model file of this machine, relative to the robot_description share (robot_driver machine
# manifest xacro_file). Empty: no 3-D view.
OPERATOR_WEB_VIEW_MODEL=urdf/MODEL.urdf
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/path/to/profile.xml
RMW_FASTRTPS_USE_QOS_FROM_XML=1
RT_CONTROL_OPERATOR_WEB_ALLOW_LAN_DDS=1
RT_OPERATOR_WEB_TOKEN_FILE=/home/USER/.config/rt-control/operator-web.token
# Optional: extra Python path (e.g. a vendored aiohttp) and extra launcher options.
OPERATOR_WEB_PYTHONPATH=
OPERATOR_WEB_EXTRA_ARGS=
